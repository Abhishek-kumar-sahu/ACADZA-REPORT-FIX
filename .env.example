# Copy to .env. Never commit .env.
# Local default is SQLite. Production: persistent PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/acadza
DATABASE_URL=sqlite:///./acadza.db

# LLM: anthropic | openai_compat | none   (none = rules-only mode, clearly labelled in UI)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_S=45
LLM_MAX_CONCURRENCY=4

# Optional second provider used if the primary fails
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=

# Optional, display-only cost estimate (USD per million tokens)
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=

# Routing thresholds (docs/RULES.md R-44)
AUTO_APPLY_MIN_CONFIDENCE=0.85
NO_CHANGE_MIN_CONFIDENCE=0.60

# REQUIRED for faculty writes (approve/reject/edit/rollback). Empty = read-only console.
FACULTY_ACCESS_KEY=

# Dev only, comma-separated
CORS_ORIGINS=

BOOT_FROM_SNAPSHOT=true

# Empty DB on startup -> hash-verified import of data/
BOOT_IMPORT=true
# No triage run yet on startup -> run the rules engine once (proposals only)
BOOT_TRIAGE=true
LOG_LEVEL=INFO
MAX_BODY_BYTES=65536
